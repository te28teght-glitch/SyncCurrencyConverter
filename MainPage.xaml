<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SyncCurrencyConverter.MainPage">
    
    <Grid RowDefinitions="Auto, Auto, Auto, Auto"
          ColumnDefinitions="*, *"
          RowSpacing="10"
          ColumnSpacing="10"
          Padding="20">
        
        <Button x:Name="btn1"
                Text="Кнопка 1"
                BackgroundColor="#FF860CB6"
                TextColor="White" 
                BorderColor="White"
                BorderWidth="2"
                CornerRadius="8"
                Clicked="OnButtonClicked"/>
        
        <Button x:Name="btn2"
                Text="Кнопка 2"
                BackgroundColor="#FF860CB6"
                TextColor="White" 
                BorderColor="White"
                BorderWidth="2"
                CornerRadius="8"
                Clicked="OnButtonClicked"/>
        
        <Button x:Name="btn3"
                Text="Кнопка 3"
                BackgroundColor="#FF860CB6"
                TextColor="White" 
                BorderColor="White"
                BorderWidth="2"
                CornerRadius="8"
                Clicked="OnButtonClicked"/>
        
        <Button x:Name="btn4"
                Text="Кнопка 4"
                BackgroundColor="#FF860CB6"
                TextColor="White" 
                BorderColor="White"
                BorderWidth="2"
                CornerRadius="8"
                Clicked="OnButtonClicked"/>
        
        <Label x:Name="statusLabel"
               Text="Ничего не выбрано"
               Grid.Row="2"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               HorizontalOptions="Center"
               Margin="0,20,0,0"/>
        
    </Grid>
</ContentPage>